load('../../tilt/dotenv.Tiltfile', 'env_secret', 'env_value')

docker_build(
    'quality-loop',
    '../../',
    dockerfile='../../docker/nest-app.Dockerfile',
    build_args={'APP': 'quality-loop'},
    only=[
        './package.json',
        './pnpm-lock.yaml',
        './pnpm-workspace.yaml',
        './nx.json',
        './tsconfig.base.json',
        './vite.nest.ts',
        './docker/rds-global-bundle.pem',
        './packages/contracts',
        './packages/db',
        './packages/llm',
        './packages/nest-kit',
        './packages/pgvector-kit',
        './packages/run-dump',
        './packages/quality-loop',
    ],
)

# The model. The loop runs only on a Claude Code subscription login, and a
# pod has no `claude login` — so it signs in with the long-lived token
# `claude setup-token` prints. With no token the pod starts and exits 1 with
# the loop's own message, instead of hanging on a Secret that does not exist.
# Warn here, because that exit is easy to misread. The embedding settings ride
# along, so memory works in the pod as it does on this machine.
if not env_value('CLAUDE_CODE_OAUTH_TOKEN'):
    warn(
        'quality-loop: no CLAUDE_CODE_OAUTH_TOKEN in this shell or in .env.\n'
        + '  The pod signs in to Claude Code with that token (a pod has no `claude login`),\n'
        + '  so it will exit at boot and grading, coaching and prompt generation stay\n'
        + '  unavailable until it has one.\n'
        + '  Fix: run `claude setup-token`, put CLAUDE_CODE_OAUTH_TOKEN=<token> in .env, then `tilt up`.'
    )

k8s_yaml(env_secret('quality-loop-model', [
    'CLAUDE_CODE_OAUTH_TOKEN',
    'LLM_MODEL',
    'OPENAI_API_KEY',
    'OPENAI_EMBEDDING_MODEL',
]))

k8s_yaml(['./k8s/local/deployment.yaml'])

k8s_resource(
    'quality-loop',
    objects=['quality-loop-model:secret', 'quality-loop-runs:persistentvolumeclaim'],
    port_forwards=3003,
    resource_deps=['db: migration:up'],
    labels=['backend'],
    links=['http://localhost:3003/health']
)
