load('../../tilt/toolchain.Tiltfile', 'tool_env')

docker_build(
    'studio-api',
    '../../',
    dockerfile='../../docker/nest-app.Dockerfile',
    build_args={'APP': 'studio-api'},
    only=[
        './package.json',
        './pnpm-lock.yaml',
        './pnpm-workspace.yaml',
        './nx.json',
        './tsconfig.base.json',
        './vite.nest.ts',
        './docker',
        './packages/contracts',
        './packages/criteria',
        './packages/db',
        './packages/studio-api',
    ],
)

k8s_yaml(['./k8s/local/deployment.yaml'])

k8s_resource(
    'studio-api',
    port_forwards=3000,
    resource_deps=['db: migration:up'],
    labels=['backend'],
    links=['http://localhost:3000/api/health']
)
