{
  "name": "govcon-ui",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/govcon-ui/src",
  "projectType": "application",
  "tags": ["type:app", "scope:web"],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/govcon-ui",
        "command": "next dev -p 4202"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "outputs": ["{projectRoot}/.next"],
      "options": {
        "cwd": "packages/govcon-ui",
        "command": "next build"
      }
    },
    "start": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "cwd": "packages/govcon-ui",
        "command": "rm -rf .next/standalone/packages/govcon-ui/.next/static && cp -R .next/static .next/standalone/packages/govcon-ui/.next/static && PORT=4202 node .next/standalone/packages/govcon-ui/server.js"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "packages/govcon-ui",
        "command": "tsc --noEmit -p tsconfig.json"
      }
    }
  },
  "// start": "the standalone server a build writes (output: standalone in next.web.js), on 4202; next start only warns and serves without it. The static chunks are copied beside it first, since the build does not trace them in."
}
