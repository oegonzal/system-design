docker_build(
    'gmail',
    '../../',
    dockerfile='../../docker/nest-app.Dockerfile',
    build_args={'APP': 'gmail'},
    only=[
        './package.json',
        './pnpm-lock.yaml',
        './pnpm-workspace.yaml',
        './nx.json',
        './tsconfig.base.json',
        './vite.nest.ts',
        './docker/rds-global-bundle.pem',
        './packages/contracts',
        './packages/nest-kit',
        './packages/config-kit',
        './packages/loop-client',
        './packages/db',
        './packages/notifications-client',
        './packages/tool-session',
        './packages/google-kit',
        './packages/gmail',
    ],
)

load('../../tilt/dotenv.Tiltfile', 'env_secret')

# The OAuth client and the refresh token, from the shell or .env; a pod has no token file to read.
k8s_yaml(env_secret('google-oauth', [
    'GOOGLE_OAUTH_CLIENT_ID',
    'GOOGLE_OAUTH_CLIENT_SECRET',
    'GOOGLE_OAUTH_REFRESH_TOKEN',
]))
k8s_yaml(['./k8s/local/deployment.yaml'])

# Its sessions run on the loop and it talks to a person through the bus, so it starts once both are up.
k8s_resource(
    'gmail',
    port_forwards=3008,
    resource_deps=['quality-loop', 'notifications'],
    labels=['backend'],
    links=['http://localhost:3008/health']
)
