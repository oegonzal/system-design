load('../../tilt/dotenv.Tiltfile', 'env_secret', 'env_value')

docker_build(
    'notifications',
    '../../',
    dockerfile='../../docker/nest-app.Dockerfile',
    build_args={'APP': 'notifications'},
    only=[
        './package.json',
        './pnpm-lock.yaml',
        './pnpm-workspace.yaml',
        './nx.json',
        './tsconfig.base.json',
        './vite.nest.ts',
        './docker/rds-global-bundle.pem',
        './packages/contracts',
        './packages/db',
        './packages/nest-kit',
        './packages/config-kit',
        './packages/notifications',
    ],
)

def _bound_variables(channels_file):
    """Every variable a channels file binds, once each, in the order it binds them."""
    bound = []
    for kind in read_json(channels_file).values():
        for instance in kind['instances'].values():
            for name in instance['env'].values():
                if name not in bound:
                    bound.append(name)
    return bound

# The variables the chosen channels file binds -- each bot's token, its
# username and the chat it serves -- read from that file, so no name is
# repeated here. Telegram takes one poller per token: run the service here or
# with `pnpm notifications:serve`, never both.
_channels_file = './config/channels/%s.json' % read_json('./config/engine.json')['channels']
_bound = _bound_variables(_channels_file)
_unset = [name for name in _bound if not env_value(name)]
if _unset:
    warn(
        'notifications: unset in this shell and in .env: %s.\n' % ', '.join(_unset)
        + '  %s binds them; an unset bot token refuses the pod\'s boot, naming it.\n' % _channels_file
        + '  Fix: set them in .env, or choose channels "none" in config/engine.json.'
    )

k8s_yaml(env_secret('notifications-telegram', _bound))

k8s_yaml(['./k8s/local/deployment.yaml'])

k8s_resource(
    'notifications',
    objects=['notifications-telegram:secret'],
    port_forwards=3005,
    resource_deps=['db: migration:up'],
    labels=['backend'],
    links=['http://localhost:3005/health']
)
