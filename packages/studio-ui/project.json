{
  "name": "studio-ui",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/studio-ui/src",
  "projectType": "application",
  "tags": ["type:app", "scope:web"],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/studio-ui",
        "command": "next dev -p {args.port}",
        "port": 4200
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "outputs": ["{projectRoot}/.next"],
      "options": {
        "cwd": "packages/studio-ui",
        "command": "next build"
      }
    },
    "start": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "cwd": "packages/studio-ui",
        "command": "rm -rf .next/standalone/packages/studio-ui/.next/static && cp -R .next/static .next/standalone/packages/studio-ui/.next/static && PORT=4200 node .next/standalone/packages/studio-ui/server.js"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "packages/studio-ui",
        "command": "tsc --noEmit -p tsconfig.json"
      }
    }
  },
  "// serve": "next dev on 4200 unless --port says otherwise; the e2e suite starts its own UI with --port so it never shares a developer's dev server.",
  "// start": "the standalone server a build writes (output: standalone in next.web.js), on 4200; next start only warns and serves without it. The static chunks are copied beside it first, since the build does not trace them in."
}
