---
import Container from '../components/Container.astro';
import EmailLink from '../components/EmailLink.astro';
import FactValue from '../components/FactValue.astro';
import IconCard from '../components/IconCard.astro';
import PageHeader from '../components/PageHeader.astro';
import { COMPANY } from '../data/company';
import BaseLayout from '../layouts/BaseLayout.astro';

const channels = [
  {
    icon: 'mail',
    title: 'General inquiries',
    purpose: 'general inquiries',
    address: COMPANY.email.general,
    text: 'Projects, consultations and questions about our services.',
  },
  {
    icon: 'landmark',
    title: 'Government, contracting and teaming',
    purpose: 'government, contracting and teaming',
    address: COMPANY.email.contracts,
    text: 'Solicitations, capability requests, subcontracting and teaming.',
  },
] as const;

const description = `Contact Enfav LLC: ${channels.map(({ purpose, address }) => `${address.value} for ${purpose}`).join(', ')}.`;

const include = [
  'Your organization and role',
  'The problem or process you want to change',
  'Timeline and constraints — security, compliance, hosting',
  'For government work, the solicitation or contract vehicle if there is one',
];
---

<BaseLayout title="Contact — Enfav LLC" description={description}>
  <PageHeader title="Contact" lede="Email is the best way to reach us." />

  <Container class="py-14 sm:py-20">
    <ul class="grid gap-6 sm:grid-cols-2">
      {channels.map((channel) => <li>
        <IconCard icon={channel.icon}>
          <h2 class="text-lg font-semibold">{channel.title}</h2>
          <p class="mt-3 text-lg font-semibold">
            <EmailLink address={channel.address} class="text-link underline underline-offset-4" />
          </p>
          <p class="mt-3 leading-7 text-ink-soft">{channel.text}</p>
        </IconCard>
      </li>)}
    </ul>

    <p class="mt-8 leading-7 text-ink-soft">
      <FactValue fact={COMPANY.location} /> · <FactValue fact={COMPANY.delivery} />
    </p>

    <section aria-labelledby="include-title" class="mt-14 max-w-2xl">
      <h2 id="include-title" class="text-2xl font-bold tracking-tight">What to include</h2>
      <ul class="mt-4 list-disc space-y-2 pl-5 leading-7 marker:text-accent">
        {include.map((item) => <li>{item}</li>)}
      </ul>
    </section>
  </Container>
</BaseLayout>
