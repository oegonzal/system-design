---
import CtaBand from '../components/CtaBand.astro';
import FactValue from '../components/FactValue.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import { COMPANY } from '../data/company';
import { FOUNDER } from '../data/founder';
import { CLOSING_CTA, SITE } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import { confirmed } from '../lib/fact';

const principles = [
  {
    title: 'Measured, not assumed',
    text: 'Quality is defined up front and checked automatically — tests for software, critics and evaluators for AI.',
  },
  {
    title: 'Traceable decisions',
    text: 'AI workflows keep a record of what was decided and why.',
  },
  {
    title: 'Built to be operated',
    text: 'Observability, documentation and runbooks are part of the deliverable.',
  },
  {
    title: 'Plain dealing',
    text: 'We say what we know, mark what we do not, and never present an unverified claim as fact.',
  },
];

// Search results state the founding year and the founder's name only once each is confirmed.
// The page names the founder through the fact, but the bio (founder.ts) restates both as copy.
const year = confirmed(COMPANY.founded);
const name = confirmed(COMPANY.founder.name);
const description = `Enfav LLC is an AI-focused software engineering company founded${year === undefined ? '' : ` in ${year}`} by ${name === undefined ? '' : `${name}, `}a full-stack engineer with ten-plus years of production experience.`;
---

<BaseLayout title="About — Enfav LLC" description={description}>
  <PageHeader title="About Enfav" lede={SITE.summary} />

  <Section id="principles" title="Principles">
    <ul class="grid gap-6 sm:grid-cols-2">
      {principles.map((principle) => <li class="rounded-xl border border-line p-6">
        <h3 class="text-lg font-semibold">{principle.title}</h3>
        <p class="mt-2 leading-7 text-ink-soft">{principle.text}</p>
      </li>)}
    </ul>
  </Section>

  <Section id="founder" title="Founder" tone="muted">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)]">
      <div>
        <p class="text-xl font-semibold"><FactValue fact={COMPANY.founder.name} /></p>
        <p class="text-ink-soft"><FactValue fact={COMPANY.founder.title} /></p>
        {FOUNDER.bio.map((paragraph) => <p class="mt-4 leading-7">{paragraph}</p>)}
        <p class="mt-4 text-ink-soft">{FOUNDER.education}</p>
      </div>
      <div class="space-y-8">
        <div>
          <h3 class="text-lg font-semibold">Prior professional experience</h3>
          <p class="mt-1 text-sm text-ink-soft">
            Before Enfav LLC. The founder's individual experience, not Enfav LLC contract past
            performance.
          </p>
          <ul class="mt-4 list-disc space-y-2 pl-5 leading-7">
            {FOUNDER.priorExperience.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <div>
          <h3 class="text-lg font-semibold">Founder projects</h3>
          <p class="mt-1 text-sm text-ink-soft">
            Begun 2025–2026 and continued at Enfav; not client work.
          </p>
          <ul class="mt-4 list-disc space-y-2 pl-5 leading-7">
            {FOUNDER.projects.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </Section>

  <CtaBand {...CLOSING_CTA} />
</BaseLayout>
