---
import CtaBand from '../components/CtaBand.astro';
import FactValue from '../components/FactValue.astro';
import ItemList from '../components/ItemList.astro';
import NumberedCard from '../components/NumberedCard.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import { COMPANY } from '../data/company';
import { FOUNDER } from '../data/founder';
import { CLOSING_CTA, SITE } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatMonths, yearOf } from '../lib/dates';

const principles = [
  {
    title: 'Measured, not assumed',
    text: 'Quality is defined up front and checked automatically — tests for software, critics and evaluators for AI.',
  },
  {
    title: 'Traceable decisions',
    text: 'AI workflows keep a record of what was decided and why.',
  },
  {
    title: 'Built to be operated',
    text: 'Observability, documentation and runbooks are part of the deliverable.',
  },
  {
    title: 'Plain dealing',
    text: 'We say what we know, mark what we do not, and never present an unverified claim as fact.',
  },
];

// The page names the founder through the facts; the bio (founder.ts) restates the name and the year as copy.
const description = `Enfav LLC was founded in ${yearOf(COMPANY.organized.value)} by ${COMPANY.founder.name.value}, ${FOUNDER.summary}.`;
---

<BaseLayout title="About — Enfav LLC" description={description}>
  <PageHeader title="About Enfav" lede={SITE.summary} />

  <Section id="principles" title="Principles">
    <ItemList items={principles} tone="panel" />
  </Section>

  <Section id="founder" title="Founder" tone="muted">
    <div class="max-w-3xl">
      <div data-person="founder">
        <p class="text-xl font-semibold"><FactValue fact={COMPANY.founder.name} /></p>
        <p class="font-semibold text-accent-strong"><FactValue fact={COMPANY.founder.title} /></p>
      </div>
      {FOUNDER.bio.map((paragraph) => <p class="mt-4 leading-7">{paragraph}</p>)}
      <p class="mt-4 text-ink-soft">{FOUNDER.education}</p>
    </div>
  </Section>

  <Section id="experience" eyebrow="Newest first" title="Prior professional experience">
    <div data-employment-list>
      <p data-employment-note class="max-w-3xl text-ink-soft">{FOUNDER.experienceNote}</p>
      <ol role="list" class="mt-8 border-l-2 border-accent">
        {FOUNDER.experience.map((job) => <li data-employment class="relative pl-6 pb-10 last:pb-0">
          <span
            aria-hidden="true"
            class="absolute top-1.5 -left-2 size-3 rounded-full bg-accent"
          ></span>
          <h3 class="text-lg font-semibold" data-employer>{job.employer}</h3>
          <p class="text-ink-soft">
            {job.role} ·
            <span data-employment-dates class="tabular-nums">{formatMonths(job.period)}</span>
          </p>
          <ul class="mt-3 list-disc space-y-2 pl-5 leading-7 marker:text-accent">
            {job.highlights.map((item) => <li>{item}</li>)}
          </ul>
        </li>)}
      </ol>
    </div>
  </Section>

  <Section id="systems" eyebrow="Not client work" title="Founder-developed AI systems" tone="muted">
    <p class="max-w-3xl text-ink-soft">{FOUNDER.systemsNote}</p>
    <ol role="list" class="mt-6 grid gap-6 sm:grid-cols-2">
      {FOUNDER.systems.map(({ title, text }, index) => (
        <NumberedCard index={index + 1} title={title} text={text} />
      ))}
    </ol>
  </Section>

  <CtaBand {...CLOSING_CTA} />
</BaseLayout>
