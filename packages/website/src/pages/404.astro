---
import Button from '../components/Button.astro';
import HeroFigure from '../components/HeroFigure.astro';
import PageHeader from '../components/PageHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found — Enfav LLC"
  description="The page you asked for does not exist or has moved."
  noindex
>
  <PageHeader
    eyebrow="Error 404"
    title="Page not found"
    lede="The page you asked for does not exist or has moved."
  >
    <div class="mt-8 flex flex-wrap gap-3 print:hidden">
      <Button href="/" variant="solid">Home</Button>
      <Button href="/services/" variant="outline">Services</Button>
      <Button href="/contact/" variant="outline">Contact</Button>
    </div>
    <HeroFigure slot="figure" />
  </PageHeader>
</BaseLayout>
