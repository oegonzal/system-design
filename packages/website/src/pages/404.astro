---
import Button from '../components/Button.astro';
import Container from '../components/Container.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found — Enfav LLC"
  description="The page you asked for does not exist or has moved."
  noindex
>
  <Container class="py-20 sm:py-28">
    <h1 class="text-4xl font-bold tracking-tight">Page not found</h1>
    <p class="mt-4 text-lg leading-8 text-ink-soft">
      The page you asked for does not exist or has moved.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <Button href="/">Home</Button>
      <Button href="/services/">Services</Button>
      <Button href="/contact/">Contact</Button>
    </div>
  </Container>
</BaseLayout>
