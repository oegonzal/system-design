---
import CtaBand from '../components/CtaBand.astro';
import Container from '../components/Container.astro';
import ItemList from '../components/ItemList.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import TechnologyList from '../components/TechnologyList.astro';
import { ENGAGEMENTS, SERVICES, TECHNOLOGY } from '../data/services';
import { CLOSING_CTA } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Services — Enfav LLC"
  description="Agentic workflow engineering, document intelligence and RAG, systems and data integration, and AI-assisted QA and browser automation."
>
  <PageHeader
    title="Services"
    lede="How we put AI and modern software into production, and bounded ways to start."
  />

  <Container class="py-14 sm:py-20">
    <div class="divide-y divide-line">
      {SERVICES.map((service) => <section
        id={service.id}
        aria-labelledby={`${service.id}-title`}
        class="grid gap-6 py-10 first:pt-0 last:pb-0 lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)] lg:gap-12"
      >
        <div>
          <h2 id={`${service.id}-title`} class="text-2xl font-bold tracking-tight">
            {service.title}
          </h2>
          <p class="mt-4 text-lg leading-8 text-ink-soft">{service.summary}</p>
        </div>
        <div>
          <h3 class="text-sm font-semibold tracking-wide text-ink-soft uppercase">Deliverables</h3>
          <ul class="mt-3 list-disc space-y-2 pl-5 leading-7">
            {service.deliverables.map((deliverable) => <li>{deliverable}</li>)}
          </ul>
        </div>
      </section>)}
    </div>
  </Container>

  <Section id="engagements" title="Ways to engage" tone="muted">
    <ItemList items={ENGAGEMENTS} />
  </Section>

  <Section id="technology" title="Applied technology">
    <TechnologyList areas={TECHNOLOGY} />
  </Section>

  <CtaBand {...CLOSING_CTA} />
</BaseLayout>
