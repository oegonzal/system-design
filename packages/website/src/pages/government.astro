---
import Container from '../components/Container.astro';
import EmailLink from '../components/EmailLink.astro';
import FactList from '../components/FactList.astro';
import FactValue from '../components/FactValue.astro';
import ItemList from '../components/ItemList.astro';
import NumberedCard from '../components/NumberedCard.astro';
import PageHeader from '../components/PageHeader.astro';
import Registration from '../components/Registration.astro';
import Section from '../components/Section.astro';
import TechnologyList from '../components/TechnologyList.astro';
import { COMPANY, COMPANY_DETAILS } from '../data/company';
import { FOUNDER } from '../data/founder';
import { ENGAGEMENTS, SERVICES, TECHNOLOGY } from '../data/services';
import { SITE } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatYears, yearOf } from '../lib/dates';

const useCases = [
  {
    title: 'Document and case intake',
    text: 'Classify submissions, extract fields, validate them against rules and route exceptions to a reviewer.',
  },
  {
    title: 'Knowledge and policy retrieval',
    text: 'Traceable internal search over approved documentation, with citations and human review.',
  },
  {
    title: 'Operations workflow integration',
    text: 'Records and status synchronized across APIs, databases and existing administrative systems.',
  },
];

const riskControls = [
  {
    title: 'Evaluation and governance',
    text: 'Scoping criteria, acceptance tests, schema validation, traceability and documented human-in-the-loop controls, as appropriate.',
  },
  {
    title: 'Production-informed build',
    text: 'Typed APIs, modular components, observability, CI test automation, rollout planning and a maintainable handoff.',
  },
];

const contact = COMPANY.pointOfContact;

// Paper has no links: the printed statement spells out the site's address.
const host = new URL(SITE.origin).host;
---

<BaseLayout
  title="Government contracting & capability statement — Enfav LLC"
  description="Enfav LLC's federal capability statement: service lines, engagements, SAM.gov registration (UEI, CAGE, NAICS, PSC) and a point of contact."
>
  <PageHeader
    eyebrow="Federal capability statement"
    title="Government contracting"
    lede="Enfav LLC designs and integrates AI-centered workflows. For federal prime contractors it focuses on bounded, inspectable software deliverables: agent orchestration, reliable data retrieval, workflow automation, service integration and engineering validation."
  >
    <p
      class="mt-6 inline-block rounded-md bg-on-brand/10 px-3 py-2 font-semibold print:mt-1 print:bg-transparent print:p-0 print:text-xs"
    >
      <Registration />
    </p>
  </PageHeader>

  <Container class="pt-8 print:hidden">
    <p class="rounded-md border border-line bg-surface-tint px-4 py-3 text-sm text-ink-soft">
      This page prints as a two-page capability statement — use your browser's Print or Save as PDF.
    </p>
  </Container>

  <Section id="service-lines" eyebrow="What Enfav builds" title="Core service lines">
    <ol class="grid gap-6 sm:grid-cols-2 print:grid-cols-2 print:gap-x-6 print:gap-y-1">
      {SERVICES.map(({ title, line }, index) => (
        <NumberedCard index={index + 1} title={title} text={line} />
      ))}
    </ol>
  </Section>

  <Section
    id="engagements"
    eyebrow="Bounded, inspectable deliverables"
    title="Engagements for prime contractors"
    tone="muted"
  >
    <ol class="grid gap-6 sm:grid-cols-2 print:grid-cols-2 print:gap-x-6 print:gap-y-1">
      {ENGAGEMENTS.map(({ title, text }, index) => (
        <NumberedCard index={index + 1} title={title} text={text} />
      ))}
    </ol>
  </Section>

  <Section id="company-data" title="Contracting profile">
    <div class="max-w-3xl print:max-w-none print:text-print-data print:leading-snug">
      <FactList details={COMPANY_DETAILS} />
    </div>
  </Section>

  <Section id="delivery-evidence" title="Delivery evidence" tone="muted">
    <p class="max-w-3xl leading-7 text-ink-soft print:max-w-none print:text-xs print:leading-snug">
      Enfav LLC was organized in {yearOf(COMPANY.organized.value)} and has no federal contract past
      performance yet.
    </p>
    <h3 class="mt-8 text-lg font-semibold print:mt-1 print:text-sm">
      Founder-developed AI systems
    </h3>
    <p class="mt-1 text-sm text-ink-soft print:mt-0 print:break-after-avoid print:text-xs">
      {FOUNDER.systemsNote}
    </p>
    <ol
      class="mt-3 grid gap-4 sm:grid-cols-2 print:mt-0.5 print:grid-cols-2 print:gap-x-6 print:gap-y-1"
    >
      {FOUNDER.systems.map(({ title, text }, index) => (
        <NumberedCard index={index + 1} title={title} text={text} />
      ))}
    </ol>
    <div data-employment-list class="mt-8 print:mt-1">
      <h3 class="text-lg font-semibold print:text-sm">Prior employment</h3>
      <p
        data-employment-note
        class="mt-1 text-sm text-ink-soft print:mt-0 print:break-after-avoid print:text-xs"
      >
        {FOUNDER.experienceNote}
      </p>
      <ol class="mt-3 space-y-2 print:mt-0.5 print:space-y-0.5">
        {FOUNDER.experience.map((job) => <li
          data-employment
          class="leading-7 break-inside-avoid print:text-xs print:leading-snug"
        >
          <span class="font-semibold"
            ><span data-employer>{job.employer}</span> ·
            <span data-employment-dates>{formatYears(job.period)}</span></span
          >
          <span class="text-ink-soft">— {job.summary}</span>
        </li>)}
      </ol>
      <p class="mt-3 text-sm print:hidden">
        Roles and details are on the
        <a href="/about/#experience" class="text-link underline underline-offset-4">About page</a>.
      </p>
    </div>
  </Section>

  <Section id="use-cases" title="Illustrative use cases">
    <ItemList items={useCases} />
  </Section>

  <Section id="delivery-risk" title="How Enfav reduces delivery risk" tone="muted">
    <ItemList items={riskControls} tone="panel" />
  </Section>

  <Section id="technology" title="Applied technology">
    <TechnologyList areas={TECHNOLOGY} />
  </Section>

  <Section id="contact" eyebrow="Contracting / teaming" title="Point of contact" tone="brand">
    <div
      class="grid gap-8 break-inside-avoid sm:grid-cols-2 print:grid-cols-2 print:gap-4 print:text-xs"
    >
      <div>
        <p data-person="pointOfContact">
          <span class="font-semibold"><FactValue fact={contact.name} /></span>,
          <FactValue fact={contact.title} />
        </p>
        <p class="mt-2 text-on-brand-soft print:mt-0 print:text-ink-soft">
          Contracting and teaming:
          <EmailLink
            address={COMPANY.email.contracts}
            class="text-on-brand underline underline-offset-4 print:text-link"
          />
        </p>
        <p class="mt-1 text-on-brand-soft print:mt-0 print:text-ink-soft">
          General inquiries:
          <EmailLink
            address={COMPANY.email.general}
            class="text-on-brand underline underline-offset-4 print:text-link"
          />
        </p>
        <p class="hidden print:block">Website: {host}</p>
        <p class="mt-1 text-on-brand-soft print:mt-0 print:text-ink-soft">
          <FactValue fact={COMPANY.location} /> · <FactValue fact={COMPANY.delivery} />
        </p>
      </div>
      <div>
        <h3 class="font-semibold">Teaming and subcontracting</h3>
        <p
          class="mt-2 leading-7 text-on-brand-soft print:mt-0 print:leading-snug print:text-ink-soft"
        >
          We welcome teaming and subcontracting conversations with prime contractors. Email
          <EmailLink
            address={COMPANY.email.contracts}
            class="text-on-brand underline underline-offset-4 print:text-link"
          />
          with the solicitation or program and the scope you need covered.
        </p>
      </div>
    </div>
  </Section>

  <Container class="py-10 print:py-1">
    <p
      class="max-w-3xl text-sm leading-6 text-ink-soft print:max-w-none print:text-print-note print:leading-snug"
    >
      Enfav LLC offers unclassified software services. Access to restricted information, on-site
      performance, insurance and cybersecurity controls are set for each engagement by the prime
      contractor and the subcontract. Service categories are offered as capability alignment: no
      representation is made that a PSC code is a registration credential or that Enfav LLC holds a
      clearance, and no special set-aside certifications are claimed.
    </p>
  </Container>
</BaseLayout>
