---
import iconArt from '../assets/icon.svg';
import Button from '../components/Button.astro';
import CtaBand from '../components/CtaBand.astro';
import PageHeader from '../components/PageHeader.astro';
import Registration from '../components/Registration.astro';
import Section from '../components/Section.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { COMPANY } from '../data/company';
import { SERVICES } from '../data/services';
import { CLOSING_CTA, PRIMARY_ACTION, SITE } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import { organizationGraph } from '../lib/structured-data';
import { getImage } from 'astro:assets';

const logo = await getImage({ src: iconArt, format: 'png', width: 512, height: 512 });

const structuredData = organizationGraph(
  {
    legalName: COMPANY.legalName,
    email: COMPANY.email.general,
    founder: COMPANY.founder,
    organized: COMPANY.organized,
    address: COMPANY.address,
  },
  SITE,
  new URL(logo.src, SITE.origin).href,
);

const steps = [
  {
    title: 'Define the outcome',
    text: 'We start from the decision or process you want to change, the data it may use and the acceptance criteria a good result must meet.',
  },
  {
    title: 'Design for production',
    text: 'Architecture, data flow and failure modes are settled before code — what runs where, what it costs, how it is observed.',
  },
  {
    title: 'Build with evaluation',
    text: 'Automated tests and schema validation, and for AI work critics and evaluators, run on every change, with human review where it matters.',
  },
  {
    title: 'Hand over cleanly',
    text: 'You receive typed, tested, documented code, with the observability and runbooks to operate it.',
  },
];
---

<BaseLayout
  title="Enfav LLC — Agentic AI and workflow automation"
  description="Enfav LLC designs and integrates agentic AI workflows, document intelligence, systems integration and AI-assisted QA for commercial and public-sector teams."
  structuredData={structuredData}
>
  <PageHeader
    title="Agentic AI and workflow automation, built to production standards."
    lede="From document-heavy operations to controlled AI workflows, connected systems and measurable engineering outcomes."
  >
    <div class="mt-8 flex flex-wrap gap-3 print:hidden">
      <Button href={PRIMARY_ACTION.href} variant="solid">{PRIMARY_ACTION.action}</Button>
      <Button href="/government/" variant="outline">Government contracting</Button>
    </div>
  </PageHeader>

  <Section id="services" title="What we build">
    <ul class="grid gap-6 sm:grid-cols-2">
      {SERVICES.map((service) => <li>
        <ServiceCard service={service} />
      </li>)}
    </ul>
  </Section>

  <Section id="approach" title="How we work" tone="muted">
    <ol class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {steps.map((step, index) => <li class="rounded-xl border border-line bg-surface p-6">
        <p class="text-sm font-semibold text-ink-soft">Step {index + 1}</p>
        <h3 class="mt-1 text-lg font-semibold">{step.title}</h3>
        <p class="mt-3 leading-7 text-ink-soft">{step.text}</p>
      </li>)}
    </ol>
  </Section>

  <Section id="government" title="For government buyers and prime contractors">
    <div class="flex flex-col items-start gap-6 lg:flex-row lg:items-center lg:justify-between">
      <div class="max-w-2xl">
        <p class="text-lg leading-8 text-ink-soft">
          Enfav LLC offers agentic AI and software engineering to government agencies, directly or
          as a subcontractor and teaming partner to prime contractors.
        </p>
        <p class="mt-3 font-semibold"><Registration /></p>
      </div>
      <Button href="/government/">Read the capability statement</Button>
    </div>
  </Section>

  <CtaBand {...CLOSING_CTA} />
</BaseLayout>
