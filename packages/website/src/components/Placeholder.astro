---
/**
 * The visible mark of a detail the owner has not confirmed yet. It says so in
 * words (never only by colour), is kept out of search snippets, and carries
 * `data-fact="placeholder"`: the e2e finds every placeholder by it, and checks
 * that each one shows its word on screen and, wherever it prints, on paper.
 * Its label is copy like any other, so the credential check reads it too.
 */
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<span
  data-fact="placeholder"
  data-nosnippet
  class="inline-flex flex-wrap items-baseline gap-x-1.5 rounded-md border border-dashed border-placeholder-line bg-placeholder-surface px-2 py-0.5 text-sm text-placeholder-ink print:py-0 print:text-xs"
>
  <strong class="font-semibold">Placeholder</strong>
  <span>— {label}</span>
</span>
