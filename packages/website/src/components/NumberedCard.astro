---
import { numeral } from '../lib/format';

/**
 * One item of a numbered list, as the capability statement counts its service
 * lines: the numeral, a title (a link when `href` is given), a line, and
 * optionally a labelled list of what it covers. An `<li>`: the caller's `<ol>`
 * carries the order, so the numeral is decoration.
 */
interface Props {
  index: number;
  title: string;
  text: string;
  href?: string;
  items?: { readonly label: string; readonly entries: readonly string[] };
}

const { index, title, text, href, items } = Astro.props;
---

<li
  class="flex h-full flex-col rounded-xl border border-line bg-surface p-6 break-inside-avoid print:rounded-none print:border-0 print:p-0"
>
  <p
    aria-hidden="true"
    class="text-sm font-bold tracking-wide text-accent-strong tabular-nums print:hidden"
  >
    {numeral(index)}
  </p>
  <h3 class="mt-2 text-lg font-semibold print:mt-0 print:text-sm">
    {href === undefined ? (
      title
    ) : (
      <a
        href={href}
        class="rounded text-link underline decoration-1 underline-offset-4 hover:decoration-2"
      >
        {title}
      </a>
    )}
  </h3>
  <p class="mt-2 leading-7 text-ink-soft print:mt-0 print:text-xs print:leading-snug">{text}</p>
  {items !== undefined && <div class="mt-4">
    <p class="text-xs font-semibold tracking-wide text-ink-soft uppercase">{items.label}</p>
    <ul class="mt-2 space-y-1.5 text-sm leading-6 text-ink-soft">
      {items.entries.map((entry) => <li class="flex gap-2">
        <span aria-hidden="true" class="mt-2.5 size-1.5 shrink-0 rounded-full bg-accent"></span>
        <span>{entry}</span>
      </li>)}
    </ul>
  </div>}
</li>
