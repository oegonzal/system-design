---
import Container from './Container.astro';
import Eyebrow from './Eyebrow.astro';

/**
 * A titled band of the page: a section landmark labelled by its own heading,
 * with an eyebrow above it when the band has one; plain, muted, or the navy
 * brand band, which prints as plain.
 */
interface Props {
  id: string;
  title: string;
  eyebrow?: string;
  tone?: 'plain' | 'muted' | 'brand';
}

const { id, title, eyebrow, tone = 'plain' } = Astro.props;
const headingId = `${id}-title`;
---

<section
  id={id}
  aria-labelledby={headingId}
  class:list={[
    'py-14 sm:py-20 print:py-1',
    tone === 'muted' && 'bg-surface-muted print:bg-transparent',
    tone === 'brand' && 'surface-brand bg-brand text-on-brand print:bg-transparent print:text-ink',
  ]}
>
  <Container>
    {eyebrow !== undefined && <Eyebrow tone={tone === 'brand' ? 'brand' : 'light'} class="mb-2"
      >{eyebrow}</Eyebrow
    >}
    <h2 id={headingId} class="text-2xl font-bold tracking-tight sm:text-3xl print:text-base">
      {title}
    </h2>
    <div class="mt-8 print:mt-1">
      <slot />
    </div>
  </Container>
</section>
