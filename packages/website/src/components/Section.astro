---
import Container from './Container.astro';

/** A titled band of the page: a section landmark labelled by its own heading. */
interface Props {
  id: string;
  title: string;
  intro?: string;
  tone?: 'plain' | 'muted';
  class?: string;
}

const { id, title, intro, tone = 'plain', class: className } = Astro.props;
const headingId = `${id}-title`;
---

<section
  id={id}
  aria-labelledby={headingId}
  class:list={[
    'py-14 sm:py-20 print:py-1.5',
    tone === 'muted' && 'bg-surface-muted print:bg-transparent',
    className,
  ]}
>
  <Container>
    <h2 id={headingId} class="text-2xl font-bold tracking-tight sm:text-3xl print:text-base">
      {title}
    </h2>
    {intro && <p class="mt-3 max-w-2xl text-lg leading-8 text-ink-soft print:text-sm">{intro}</p>}
    <div class="mt-8 print:mt-1">
      <slot />
    </div>
  </Container>
</section>
