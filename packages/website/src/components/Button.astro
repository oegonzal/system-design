---
/**
 * A call to action — always a link, since every action on this site goes
 * somewhere, and never printed: on paper it leads nowhere. `brand` (the
 * default) is the brand-coloured button for light surfaces; on the brand band,
 * `solid` is the white button and `outline` its quieter companion.
 */
interface Props {
  href: string;
  variant?: 'solid' | 'outline' | 'brand';
}

const { href, variant = 'brand' } = Astro.props;

const variants = {
  brand: 'bg-brand text-on-brand hover:bg-brand-strong',
  solid: 'bg-on-brand text-brand hover:bg-surface-muted',
  outline: 'border border-on-brand/60 text-on-brand hover:bg-on-brand/10',
} as const;
---

<a
  href={href}
  class:list={[
    'inline-flex min-h-11 items-center justify-center rounded-md px-5 text-sm font-semibold no-underline transition-colors motion-reduce:transition-none print:hidden',
    variants[variant],
  ]}
>
  <slot />
</a>
