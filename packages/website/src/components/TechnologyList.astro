---
/** Technology by area: each area's name and what it covers. */
interface Props {
  areas: readonly { readonly area: string; readonly items: readonly string[] }[];
}

const { areas } = Astro.props;
---

<dl class="grid gap-6 sm:grid-cols-3 print:grid-cols-3 print:gap-3">
  {areas.map(({ area, items }) => <div
    class="rounded-xl border border-line bg-surface-tint p-6 break-inside-avoid print:rounded-none print:border-0 print:bg-transparent print:p-0"
  >
    <dt
      class="text-xs font-semibold tracking-wide text-accent-strong uppercase print:text-sm print:tracking-normal print:text-ink print:normal-case"
    >
      {area}
    </dt>
    <dd class="mt-2 leading-7 text-ink-soft print:mt-0 print:text-xs print:leading-snug">
      {items.join(', ')}
    </dd>
  </div>)}
</dl>
