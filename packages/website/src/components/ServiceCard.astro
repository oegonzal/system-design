---
import type { Service } from '../data/services';

/** One service as a card; its heading is the link, so the link's text names the service. */
interface Props {
  service: Service;
}

const { service } = Astro.props;
---

<article class="flex h-full flex-col rounded-xl border border-line bg-surface p-6">
  <h3 class="text-lg font-semibold">
    <a
      href={`/services/#${service.id}`}
      class="rounded text-link underline decoration-1 underline-offset-4 hover:decoration-2"
    >
      {service.title}
    </a>
  </h3>
  <p class="mt-3 leading-7 text-ink-soft">{service.line}</p>
</article>
