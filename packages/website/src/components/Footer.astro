---
import { COMPANY } from '../data/company';
import { NAV, SITE, TAGLINE } from '../data/site';
import Container from './Container.astro';
import EmailLink from './EmailLink.astro';
import FactValue from './FactValue.astro';
import Registration from './Registration.astro';

const year = new Date().getFullYear();
---

<footer class="surface-brand bg-brand-strong text-on-brand-soft print:hidden">
  <Container class="grid gap-10 py-12 sm:grid-cols-3">
    <div>
      <p class="text-lg font-bold text-on-brand">{SITE.name}</p>
      <p class="text-xs font-semibold tracking-wide text-accent-bright uppercase">{TAGLINE}</p>
      <p class="mt-3 max-w-xs text-sm leading-6">{SITE.description}</p>
      <p class="mt-4 text-sm leading-6">
        <FactValue fact={COMPANY.location} /><br /><Registration />
      </p>
    </div>
    <nav aria-label="Footer">
      <p class="font-semibold text-on-brand">Company</p>
      <ul class="mt-3 space-y-1 text-sm">
        {NAV.map(({ href, label }) => <li>
          <a
            href={href}
            class="inline-flex min-h-6 items-center hover:text-on-brand hover:underline"
          >
            {label}
          </a>
        </li>)}
      </ul>
    </nav>
    <div>
      <p class="font-semibold text-on-brand">Email</p>
      <ul class="mt-3 space-y-1 text-sm">
        <li>
          General:
          <EmailLink
            address={COMPANY.email.general}
            class="underline underline-offset-4 hover:text-on-brand"
          />
        </li>
        <li>
          Government and teaming:
          <EmailLink
            address={COMPANY.email.contracts}
            class="underline underline-offset-4 hover:text-on-brand"
          />
        </li>
      </ul>
    </div>
  </Container>
  <div class="border-t border-on-brand/15">
    <Container class="py-6 text-sm">
      <p>© {year} {SITE.name}</p>
    </Container>
  </div>
</footer>
