---
import { getImage } from 'astro:assets';

import iconArt from '../assets/icon.svg';
import ogArt from '../assets/og.svg';
import { SITE } from '../data/site';
import type { PageMeta } from '../lib/page';
import { serializeJsonLd } from '../lib/structured-data';

type Props = PageMeta;

const { title, description, noindex = false, structuredData } = Astro.props;

// Absolute URLs name the production origin SITE declares.
const site = new URL(SITE.origin);
const canonical = new URL(Astro.url.pathname, site).href;

// Rasterized from the site's own SVGs at build time; social cards need a PNG.
const OG_IMAGE = { width: 1200, height: 630 } as const;
const og = await getImage({ src: ogArt, format: 'png', ...OG_IMAGE });
const TOUCH_ICON = 180;
const touchIcon = await getImage({
  src: iconArt,
  format: 'png',
  width: TOUCH_ICON,
  height: TOUCH_ICON,
});
const ogImage = new URL(og.src, site).href;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" sizes={`${TOUCH_ICON}x${TOUCH_ICON}`} href={touchIcon.src} />
<link rel="sitemap" href="/sitemap-index.xml" />
<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={SITE.locale} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{!noindex && <meta property="og:url" content={canonical} />}
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content={String(OG_IMAGE.width)} />
<meta property="og:image:height" content={String(OG_IMAGE.height)} />
<meta property="og:image:alt" content={`${SITE.name} — ${SITE.description}`} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
{structuredData && <script type="application/ld+json" set:html={serializeJsonLd(structuredData)} />}
