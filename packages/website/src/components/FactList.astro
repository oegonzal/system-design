---
import type { CompanyDetail } from '../data/company';
import FactValue from './FactValue.astro';

/**
 * Name–value pairs as a description list: the pairs stack on a narrow screen and
 * sit side by side from `sm` up, with no table to scroll sideways.
 */
interface Props {
  details: readonly CompanyDetail[];
}

const { details } = Astro.props;
---

<dl class="divide-y divide-line border-y border-line">
  {details.map(({ term, fact }) => <div
    class="grid gap-1 py-3 sm:grid-cols-[minmax(0,14rem)_minmax(0,1fr)] sm:gap-6 print:grid-cols-[minmax(0,12rem)_minmax(0,1fr)] print:py-1.5"
  >
    <dt class="font-semibold">{term}</dt>
    <dd class="text-ink-soft">
      <FactValue fact={fact} />
    </dd>
  </div>)}
</dl>
