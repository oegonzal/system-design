---
/** Titled items — a title and a line of text each — in two columns from `sm` up and on paper. */
interface Props {
  items: readonly { readonly title: string; readonly text: string }[];
}

const { items } = Astro.props;
---

<ul class="grid gap-x-10 gap-y-4 sm:grid-cols-2 print:grid-cols-2 print:gap-x-6 print:gap-y-1">
  {items.map((item) => <li class="break-inside-avoid">
    <p class="font-semibold print:text-sm">{item.title}</p>
    <p class="mt-1 leading-7 text-ink-soft print:mt-0 print:text-xs print:leading-snug">
      {item.text}
    </p>
  </li>)}
</ul>
