---
/**
 * Titled items — a title and a line of text each — in two columns from `sm`
 * up and on paper: plain, on tinted panels, or three across the brand band,
 * where the text is light.
 */
interface Props {
  items: readonly { readonly title: string; readonly text: string }[];
  tone?: 'light' | 'panel' | 'brand';
}

const { items, tone = 'light' } = Astro.props;
---

<ul
  class:list={[
    'grid gap-x-10 gap-y-4 print:grid-cols-2 print:gap-x-6 print:gap-y-1',
    tone === 'brand' ? 'sm:grid-cols-3' : 'sm:grid-cols-2',
  ]}
>
  {items.map((item) => <li
    class:list={[
      'break-inside-avoid',
      tone === 'panel' &&
        'rounded-xl border border-line bg-surface-tint p-6 print:rounded-none print:border-0 print:bg-transparent print:p-0',
    ]}
  >
    <p class="font-semibold print:text-sm">{item.title}</p>
    <p
      class:list={[
        'mt-1 leading-7 print:mt-0 print:text-xs print:leading-snug',
        tone === 'brand' ? 'text-on-brand-soft print:text-ink-soft' : 'text-ink-soft',
      ]}
    >
      {item.text}
    </p>
  </li>)}
</ul>
