load('../toolchain.Tiltfile', 'tool_env')

# The store is the docker-compose `db` service, the one definition of Postgres
# — records and, through the pgvector extension, the memories recalled by
# meaning: `tilt up` and `pnpm stack:up` share the same container, volume and
# data. Tilt only brings it up (a no-op when it already runs; the first time,
# compose builds the image) and waits until it answers; a local_resource
# leaves nothing for `tilt down` to stop.
local_resource(
    'stores',
    cmd='bash scripts/stack.sh db',
    dir=config.main_dir,
    env=tool_env(),
    labels=['database']
)

# Where a pod finds it.
k8s_yaml(['./stores.yaml'])

k8s_resource(
    new_name='stores: config',
    objects=['local-stores:configmap'],
    labels=['database']
)
