# compiled output
dist
tmp
/out-tsc
.next/
.next-dev/
.next-e2e/
# regenerated by next dev / next build per distDir; src/next-types.d.ts is the tracked half
packages/*/next-env.d.ts

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
npm-debug.log
yarn-error.log

# System Files
.DS_Store
Thumbs.db

.nx/

# Storybook static build
storybook-static/

# tooling has its own vitest cache
tooling/node_modules/

# Code review run history — local by default; CI keeps its own as an artifact.
.code-review/

# Quality-loop run dumps — local by default, unbounded, and full of author prose.
/static/runs/

# Browser session traces, the persistent Chrome profiles they sign in with, and the ingest manifest.
/static/sessions/
/static/browser-profiles/
/static/memory-ingest/

# Playwright output
test-output/
playwright-report/

# Source documents for the memory ingest: the user's own career records, which
# are personal, large, and nothing the repo should carry.
/docs/ingestion/

# Local working notes and personal files — never part of the repo.
/CLAUDE.md
/Resume_a2.pdf
/*.pdf

# TypeScript incremental build state
*.tsbuildinfo

# Environment files
.env

# Astro's generated types and caches (packages/website)
.astro/

# Per-target env files Nx loads into tasks — never committable, since a deploy
# token is exactly what someone would put there
.env.*
