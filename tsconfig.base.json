      "@sysdesign/google-kit": ["./packages/google-kit/src/index.ts"],
      "@sysdesign/google-kit/testing": ["./packages/google-kit/src/testing.ts"],
      "@sysdesign/llm": ["./packages/llm/src/index.ts"],
      "@sysdesign/loop-client": ["./packages/loop-client/src/index.ts"],
