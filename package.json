{
  "name": "system-design-prep",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "prepare": "git rev-parse --git-dir > /dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "studio-ui:serve": "nx run studio-ui:serve",
    "studio-api:serve": "nx run studio-api:serve",
    "quality-loop:serve": "nx run quality-loop:serve",
    "quality-loop:run": "nx build quality-loop && node --env-file-if-exists=.env packages/quality-loop/dist/main.js run",
    "quality-loop-ui:serve": "nx run quality-loop-ui:serve",
    "govcon": "nx build govcon && node --env-file-if-exists=.env packages/govcon/dist/main.js",
    "govcon:serve": "nx run govcon:serve",
    "govcon-ui:serve": "nx run govcon-ui:serve",
    "govcon:start": "concurrently --kill-others \"pnpm govcon:serve\" \"pnpm govcon-ui:serve\"",
    "quality:start": "concurrently --kill-others \"pnpm quality-loop:serve\" \"pnpm quality-loop-ui:serve\"",
    "start": "concurrently --kill-others \"pnpm studio-api:serve\" \"pnpm quality-loop:serve\" \"pnpm studio-ui:serve\"",
    "stack:up": "bash scripts/stack.sh up",
    "stack:down": "bash scripts/stack.sh down",
    "stack:db": "bash scripts/stack.sh db",
    "db:migrate": "SWC_NODE_PROJECT=packages/db/tsconfig.lib.json mikro-orm migration:up --config packages/db/mikro-orm.config.ts",
    "db:migrate:check": "SWC_NODE_PROJECT=packages/db/tsconfig.lib.json mikro-orm migration:check --config packages/db/mikro-orm.config.ts",
    "db:migrate:create": "SWC_NODE_PROJECT=packages/db/tsconfig.lib.json mikro-orm migration:create --config packages/db/mikro-orm.config.ts",
    "db:seed": "SWC_NODE_PROJECT=packages/db/tsconfig.lib.json node -r @swc-node/register packages/db/scripts/seed.ts",
    "review:code": "tsx --tsconfig tooling/tsconfig.json tooling/code-review/review.ts",
    "typecheck:tooling": "tsc --noEmit -p tooling/tsconfig.json",
    "test:tooling": "vitest run --config tooling/vite.config.ts",
    "test:stories": "tsx tooling/storybook-smoke/smoke.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.259",
    "@anthropic-ai/sdk": "^0.122.0",
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mikro-orm/cli": "^7.0.14",
    "@mikro-orm/core": "^7.0.14",
    "@mikro-orm/decorators": "^7.0.14",
    "@mikro-orm/migrations": "^7.0.14",
    "@mikro-orm/nestjs": "^7.0.1",
    "@mikro-orm/postgresql": "^7.0.14",
    "@nestjs/common": "^11.1.19",
    "@nestjs/core": "^11.1.19",
    "@nestjs/platform-express": "^11.1.19",
    "@qdrant/js-client-rest": "^1.19.0",
    "@xyflow/react": "^12.3.0",
    "html-to-image": "^1.11.13",
    "jspdf": "^2.5.2",
    "jszip": "^3.10.1",
    "next": "^15.1.0",
    "pg": "^8.20.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-markdown": "^10.1.0",
    "reflect-metadata": "^0.2.2",
    "remark-gfm": "^4.0.1",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^1.50.0",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.28.0",
    "@nestjs/testing": "^11.1.19",
    "@nx/devkit": "^22.7.1",
    "@nx/eslint": "^22.7.1",
    "@nx/eslint-plugin": "^22.7.1",
    "@nx/js": "^22.7.1",
    "@nx/playwright": "^22.7.1",
    "@nx/vite": "^22.7.1",
    "@nx/web": "^22.7.1",
    "@playwright/test": "^1.59.1",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/react": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@swc-node/register": "^1.11.1",
    "@swc/core": "^1.15.33",
    "@swc/helpers": "^0.5.21",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@vitejs/plugin-react": "^6.0.1",
    "axe-core": "^4.11.4",
    "concurrently": "^9.2.1",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.10.2",
    "jsdom": "^26.0.0",
    "nx": "^22.7.1",
    "prettier": "^3.8.3",
    "storybook": "^10.5.10",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
}
