{
  "name": "system-design-prep",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "prepare": "git rev-parse --git-dir > /dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "studio-ui:serve": "nx run studio-ui:serve",
    "studio-api:serve": "nx run studio-api:serve",
    "eval-worker:serve": "nx run eval-worker:serve",
    "start": "concurrently --kill-others \"pnpm studio-api:serve\" \"pnpm eval-worker:serve\" \"pnpm studio-ui:serve\"",
    "db:migrate": "SWC_NODE_PROJECT=packages/db/tsconfig.lib.json mikro-orm migration:up --config packages/db/mikro-orm.config.ts",
    "db:migrate:check": "SWC_NODE_PROJECT=packages/db/tsconfig.lib.json mikro-orm migration:check --config packages/db/mikro-orm.config.ts",
    "db:migrate:create": "SWC_NODE_PROJECT=packages/db/tsconfig.lib.json mikro-orm migration:create --config packages/db/mikro-orm.config.ts",
    "db:seed": "SWC_NODE_PROJECT=packages/db/tsconfig.lib.json node -r @swc-node/register packages/db/scripts/seed.ts",
    "review:code": "tsx tooling/code-review/review.ts",
    "typecheck:tooling": "tsc --noEmit -p tooling/tsconfig.json",
    "test:tooling": "vitest run --config tooling/vite.config.ts",
    "test:stories": "tsx tooling/storybook-smoke/smoke.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mikro-orm/cli": "^7.0.14",
    "@mikro-orm/core": "^7.0.14",
    "@mikro-orm/decorators": "^7.0.14",
    "@mikro-orm/migrations": "^7.0.14",
    "@mikro-orm/nestjs": "^7.0.1",
    "@mikro-orm/postgresql": "^7.0.14",
    "@nestjs/common": "^11.1.19",
    "@nestjs/core": "^11.1.19",
    "@nestjs/platform-express": "^11.1.19",
    "@xyflow/react": "^12.3.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "next": "^15.1.0",
    "pg": "^8.20.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@emotion/babel-plugin": "^11.13.5",
    "@eslint-react/eslint-plugin": "^1.50.0",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.28.0",
    "@nestjs/testing": "^11.1.19",
    "@nx/devkit": "^22.7.1",
    "@nx/eslint": "^22.7.1",
    "@nx/eslint-plugin": "^22.7.1",
    "@nx/js": "^22.7.1",
    "@nx/playwright": "^22.7.1",
    "@nx/react": "^22.7.1",
    "@nx/vite": "^22.7.1",
    "@nx/web": "^22.7.1",
    "@playwright/test": "^1.59.1",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/react": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@swc-node/register": "^1.11.1",
    "@swc/core": "^1.15.33",
    "@swc/helpers": "^0.5.21",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.5",
    "@vitest/ui": "^4.1.5",
    "axe-core": "^4.11.4",
    "concurrently": "^9.2.1",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-playwright": "^2.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^26.0.0",
    "nx": "^22.7.1",
    "prettier": "^3.8.3",
    "storybook": "^10.5.10",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.33.1",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  },
  "workspaces": [
    "packages/*"
  ],
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "typescript": "6",
        "eslint": "10"
      }
    },
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@parcel/watcher",
      "@swc/core",
      "esbuild",
      "nx",
      "sharp",
      "unrs-resolver"
    ]
  }
}
